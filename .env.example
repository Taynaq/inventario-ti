# Copie este arquivo para ".env" e preencha para usar o modo compartilhado (login + dados na nuvem).
# Sem estas duas linhas o app funciona em modo local: os dados ficam só no navegador.
#
# Onde achar: Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave "anon" (ou "publishable"). Nunca use a "service_role": ela dá acesso total ao banco.
VITE_SUPABASE_ANON_KEY=
