{
  "name": "inventario-ti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicativo web para celular que controla os equipamentos de TI da empresa.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
